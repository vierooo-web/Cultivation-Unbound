        local modalWindow = modalHeader.Parent
        while modalWindow and modalWindow ~= LocalPlayer.PlayerGui and modalWindow.AbsoluteSize.Y < 200 do
            modalWindow = modalWindow.Parent
        end
        if not modalWindow then modalWindow = LocalPlayer.PlayerGui end

        local targetLower = trimText(targetHerbName)
        local candidates = {}

        for _, obj in pairs(modalWindow:GetDescendants()) do
            if not obj:IsDescendantOf(UI.ScreenGui) and (obj:IsA("TextLabel") or obj:IsA("TextButton")) and trimText(obj.Text) == "choose" then
                local chooseBtn = obj:IsA("GuiButton") and obj or obj:FindFirstAncestorWhichIsA("GuiButton") or obj

                local isolatedRow = chooseBtn
                while isolatedRow.Parent and isolatedRow.Parent ~= modalWindow and isolatedRow.Parent:IsA("GuiObject") and not isolatedRow.Parent:IsA("ScrollingFrame") do
                    if countChooseButtonsInContainer(isolatedRow.Parent) <= 1 then
                        isolatedRow = isolatedRow.Parent
                    else
                        break
                    end
                end

                if isolatedRow and isolatedRow ~= chooseBtn then
                    local rowTexts = {}
                    for _, ch in pairs(isolatedRow:GetDescendants()) do
                        if ch:IsA("TextLabel") or ch:IsA("TextButton") then
                            local tx = trimText(ch.Text)
                            if tx ~= "" and tx ~= "choose" then
                                table.insert(rowTexts, tx)
                            end
                        end
                    end

                    local combinedRowText = table.concat(rowTexts, " ")

                    local isExactHerbMatch = false
                    for _, otherHerb in ipairs(Constants.HERBS_LIST) do
                        local oLow = otherHerb:lower()
                        if combinedRowText:find(oLow, 1, true) then
                            if oLow == targetLower then
                                isExactHerbMatch = true
                            else
                                isExactHerbMatch = false
                                break
                            end
                        end
                    end

                    if isExactHerbMatch then
                        local yearScore = 1
                        if combinedRowText:find("1000", 1, true) then
                            yearScore = 4
                        elseif combinedRowText:find("100", 1, true) then
                            yearScore = 3
                        elseif combinedRowText:find("10", 1, true) then
                            yearScore = 2
                        end

                        local qty = 1
                        local qtyMatch = combinedRowText:match("x(%d+)")
                        if qtyMatch then
                            qty = tonumber(qtyMatch) or 1
                        end

                        if qty > 0 then
                            table.insert(candidates, {
                                Row = isolatedRow,
                                ChooseBtn = chooseBtn,
                                Score = yearScore
                            })
                        end
                    end
                end
            end
        end

        if #candidates == 0 then
            return false
        end

        table.sort(candidates, function(a, b)
            return a.Score > b.Score
        end)

        local best = candidates[1]
        local scrollFrame = best.Row:FindFirstAncestorWhichIsA("ScrollingFrame")
        if scrollFrame then
            local sfY = scrollFrame.AbsolutePosition.Y
            local sfH = scrollFrame.AbsoluteSize.Y
            local rY = best.Row.AbsolutePosition.Y
            local rH = best.Row.AbsoluteSize.Y

            if rY < sfY or (rY + rH) > (sfY + sfH) then
                scrollFrame.CanvasPosition = Vector2.new(
                    scrollFrame.CanvasPosition.X,
                    math.max(0, scrollFrame.CanvasPosition.Y + (rY - sfY) - (sfH * 0.35))
                )
                task.wait(0.22)
            end
        end

        -- Gunakan klik tunggal bersih tanpa fallback klik fisik ganda
        triggerGuiClick(best.ChooseBtn, false, false)
        return true
    end

    -- Membaca status Slot 1 (Kiri), Slot 2 (Tengah), dan Slot 3 (Kanan) berdasarkan koordinat X di atas tombol Brew
    local function getCauldronSlotStates(brewBtnObj)
        local cauldronWin = brewBtnObj.Parent
        while cauldronWin and cauldronWin ~= LocalPlayer.PlayerGui and cauldronWin.AbsoluteSize.Y < 220 do
            cauldronWin = cauldronWin.Parent
        end
        if not cauldronWin then return nil end

        local winX = cauldronWin.AbsolutePosition.X
        local winW = cauldronWin.AbsoluteSize.X
        local brewY = brewBtnObj.AbsolutePosition.Y
        local headerY = cauldronWin.AbsolutePosition.Y

        -- Buat 3 slot tetap: 1 = Kiri, 2 = Tengah, 3 = Kanan
        local slots = {
            [1] = {Button = nil, FilledHerb = nil, IsEmpty = false},
            [2] = {Button = nil, FilledHerb = nil, IsEmpty = false},
            [3] = {Button = nil, FilledHerb = nil, IsEmpty = false}
        }

        for _, obj in pairs(cauldronWin:GetDescendants()) do
            if not obj:IsDescendantOf(UI.ScreenGui) and (obj:IsA("TextLabel") or obj:IsA("TextButton")) and isActuallyVisible(obj) then
                local posY = obj.AbsolutePosition.Y
                -- Pastikan berada di area 3 kotak slot (di atas tombol Brew dan di bawah judul)
                if posY > (headerY + 35) and posY < (brewY - 8) then
                    local centerX = obj.AbsolutePosition.X + (obj.AbsoluteSize.X / 2)
                    local relX = (centerX - winX) / math.max(winW, 1)

                    local slotIndex = nil
                    local t = trimText(obj.Text)

                    if t == "slot 1" or relX < 0.38 then
                        slotIndex = 1
                    elseif t == "slot 2" or (relX >= 0.38 and relX <= 0.62) then
                        slotIndex = 2
                    elseif t == "slot 3" or relX > 0.62 then
                        slotIndex = 3
                    end

                    if slotIndex then
                        local btn = obj:IsA("GuiButton") and obj or obj:FindFirstAncestorWhichIsA("GuiButton") or obj.Parent
                        if t == "add herb" or t:match("^slot %d$") then
                            slots[slotIndex].IsEmpty = true
                            slots[slotIndex].Button = btn
                        else
                            for _, hName in ipairs(Constants.HERBS_LIST) do
                                if t == hName:lower() then
                                    slots[slotIndex].FilledHerb = hName
                                    slots[slotIndex].Button = btn
                                    break
                                end
                            end
                        end
                    end
                end
            end
        end

        return slots
    end

    local function attemptInstantClaimCauldron()
        local cauldronTitle = findVisibleTextElement("alchemy cauldron", false)
            or findVisibleTextElement("stoke", true)
            or findVisibleTextElement("brew", true)
        if not cauldronTitle then return false end

        local cauldronWindow = cauldronTitle.Parent
        while cauldronWindow and cauldronWindow ~= LocalPlayer.PlayerGui and cauldronWindow.AbsoluteSize.Y < 220 do
            cauldronWindow = cauldronWindow.Parent
        end
        if not cauldronWindow then return false end

        for _, obj in pairs(cauldronWindow:GetDescendants()) do
            if not obj:IsDescendantOf(UI.ScreenGui) and (obj:IsA("TextLabel") or obj:IsA("TextButton")) then
                local t = trimText(obj.Text)
                if t == "claim" or t == "collect" or t == "claim pill" then
                    local btn = obj:IsA("GuiButton") and obj or obj:FindFirstAncestorWhichIsA("GuiButton")
                    if btn and isActuallyVisible(btn) then
                        triggerGuiClick(btn, true, false)
                        return true
                    end
                end
            end
        end

        pcall(function()
            for _, rem in pairs(ReplicatedStorage:GetDescendants()) do
                if rem:IsA("RemoteEvent") then
                    local rn = rem.Name:lower()
                    if rn:find("claimpill") or rn:find("collectpill") or rn:find("finishbrew") or rn == "claimcauldron" then
                        rem:FireServer()
                    end
                end
            end
        end)
        return false
    end

    local function handleStokeMinigame(stokeBtnObj)
        local modalContainer = stokeBtnObj.Parent
        while modalContainer and modalContainer ~= LocalPlayer.PlayerGui and modalContainer.AbsoluteSize.Y < 130 do
            modalContainer = modalContainer.Parent
        end
        if not modalContainer then return end

        local stokeY = stokeBtnObj.AbsolutePosition.Y
        local initialX = {}
        for _, obj in pairs(modalContainer:GetDescendants()) do
            if obj:IsA("GuiObject") and isActuallyVisible(obj) and obj.AbsolutePosition.Y < stokeY then
                if obj.AbsoluteSize.X < 180 and obj.AbsoluteSize.Y <= 60 then
                    initialX[obj] = obj.AbsolutePosition.X
                end
            end
        end

        RunService.RenderStepped:Wait()
        RunService.RenderStepped:Wait()
        RunService.RenderStepped:Wait()

        local cursorObj = nil
        local maxDelta = 0
        for obj, oldX in pairs(initialX) do
            if obj and obj.Parent then
                local dX = math.abs(obj.AbsolutePosition.X - oldX)
                if dX > 0.4 and dX > maxDelta then
                    maxDelta = dX
                    cursorObj = obj
                end
            end
        end

        local targetZoneObj = nil
        local barTrackObj = nil
        local refY = cursorObj and (cursorObj.AbsolutePosition.Y + cursorObj.AbsoluteSize.Y / 2) or (stokeY - 45)

        for _, obj in pairs(modalContainer:GetDescendants()) do
            if obj:IsA("GuiObject") and isActuallyVisible(obj) and obj ~= cursorObj and (not cursorObj or not obj:IsDescendantOf(cursorObj)) then
                local centerY = obj.AbsolutePosition.Y + (obj.AbsoluteSize.Y / 2)
                if math.abs(centerY - refY) < 35 then
                    if obj.AbsoluteSize.X >= 180 and obj.AbsoluteSize.Y <= 50 then
                        if not barTrackObj or obj.AbsoluteSize.X > barTrackObj.AbsoluteSize.X then barTrackObj = obj end
                    elseif obj.AbsoluteSize.X >= 6 and obj.AbsoluteSize.X <= 90 and obj.AbsoluteSize.Y <= 45 then
                        local dX = initialX[obj] and math.abs(obj.AbsolutePosition.X - initialX[obj]) or 0
                        if dX < 0.2 and (not targetZoneObj or obj.AbsoluteSize.X < targetZoneObj.AbsoluteSize.X) then
                            targetZoneObj = obj
                        end
                    end
                end
            end
        end

        local startTime = tick()
        local prevX = cursorObj and (cursorObj.AbsolutePosition.X + cursorObj.AbsoluteSize.X / 2) or nil

        while State.autoPillActive and isActuallyVisible(stokeBtnObj) and (tick() - startTime < 4.0) do
            if cursorObj then
                local curCenter = cursorObj.AbsolutePosition.X + (cursorObj.AbsoluteSize.X / 2)
                local velX = prevX and (curCenter - prevX) or 0
                prevX = curCenter
                local predictedX = curCenter + (velX * 1.15)

                local zMin, zMax
                if targetZoneObj then
                    local zPos = targetZoneObj.AbsolutePosition.X
                    local zSize = targetZoneObj.AbsoluteSize.X
                    local pad = math.min(zSize * 0.2, 6)
                    zMin = zPos + pad
                    zMax = (zPos + zSize) - pad
                elseif barTrackObj then
                    local bPos = barTrackObj.AbsolutePosition.X
                    local bSize = barTrackObj.AbsoluteSize.X
                    zMin = bPos + (bSize * 0.46)
                    zMax = bPos + (bSize * 0.54)
                end

                if zMin and zMax and ((predictedX >= zMin and predictedX <= zMax) or (curCenter >= zMin and curCenter <= zMax)) then
                    triggerGuiClick(stokeBtnObj, true, false)
                    break
                end
            end
            RunService.RenderStepped:Wait()
        end

        task.wait(0.25)
        attemptInstantClaimCauldron()
    end

    while true do
        if State.autoPillActive and not isUserTypingOrInMenu() then
            openCauldronIfClosed()

            -- STATE 1: Jika tombol Claim terlihat, langsung klaim
            local visibleClaim = findVisibleTextElement("claim", true)
            if visibleClaim then
                triggerGuiClick(visibleClaim, false, false)
                task.wait(0.45)

            -- STATE 2: Jika minigame Stoke sedang aktif
            else
                local stokeObj = findVisibleTextElement("stoke", true)
                if stokeObj then
                    handleStokeMinigame(stokeObj)
                    task.wait(0.4)

                -- STATE 3: Jika jendela "Choose a herb" sedang terbuka
                elseif findVisibleTextElement("choose a herb", false) then
                    local recipe = Constants.PILL_RECIPES[State.selectedPill]
                    local slotIdx = math.clamp(State.activeRecipeSlot or 1, 1, 3)
                    local requiredHerb = recipe and recipe[slotIdx] or "Ginseng"

                    local chosen = chooseExactHerbFromModal(requiredHerb)
                    if chosen then
                        task.wait(0.55)
                    else
                        local backBtn = findVisibleTextElement("back", true)
                        if backBtn then
                            triggerGuiClick(backBtn, false, false)
                        end
                        task.wait(0.55)
                    end

                -- STATE 4: Menu utama ALCHEMY CAULDRON
                else
                    local brewBtn = findVisibleTextElement("brew", true)
                    if brewBtn then
                        local recipe = Constants.PILL_RECIPES[State.selectedPill]
                        local slots = getCauldronSlotStates(brewBtn)

                        if recipe and slots then
                            local needSlotAction = false

                            for i = 1, 3 do
                                local s = slots[i]
                                local expectedHerb = recipe[i]

                                if s.IsEmpty and s.Button then
                                    -- Slot ke-i masih kosong -> klik slot ke-i & simpan nomor slotnya!
                                    State.activeRecipeSlot = i
                                    triggerGuiClick(s.Button, false, false)
                                    needSlotAction = true
                                    task.wait(0.55)
                                    break
                                elseif s.FilledHerb and s.FilledHerb:lower() ~= expectedHerb:lower() and s.Button then
                                    -- Slot ke-i berisi bahan yang salah -> klik slot ke-i untuk mengosongkannya!
                                    State.activeRecipeSlot = i
                                    triggerGuiClick(s.Button, false, false)
                                    needSlotAction = true
                                    task.wait(0.55)
                                    break
                                end
                            end

                            -- Jika ketiga slot sudah terisi dengan resep yang benar, klik Brew!
                            if not needSlotAction and slots[1].FilledHerb and slots[2].FilledHerb and slots[3].FilledHerb then
                                triggerGuiClick(brewBtn, false, false)
                                task.wait(0.65)
                            end
                        end
                    else
                        -- Sedang menunggu proses Brewing selesai -> cek tombol Claim tanpa nge-spam
                        attemptInstantClaimCauldron()
                        task.wait(0.35)
                    end
                end
            end
        end
        task.wait(0.25)
    end
end)


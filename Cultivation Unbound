                end
            end
            return false
        end

        -- Membaca status ke-3 Slot berdasarkan label "Slot 1", "Slot 2", dan "Slot 3" di jendela ALCHEMY CAULDRON
        local function readExactThreeSlots()
            local slots = {
                [1] = {Box = nil, AddBtn = nil, RemoveBtn = nil, FilledHerb = nil, IsEmpty = false},
                [2] = {Box = nil, AddBtn = nil, RemoveBtn = nil, FilledHerb = nil, IsEmpty = false},
                [3] = {Box = nil, AddBtn = nil, RemoveBtn = nil, FilledHerb = nil, IsEmpty = false}
            }


local function findElementByText(exactOrPartialText, exactMatch, allowHidden)
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return nil end
    
    local targetLower = trimText(exactOrPartialText)
    for _, obj in pairs(playerGui:GetDescendants()) do
        if obj ~= ScreenGui and not obj:IsDescendantOf(ScreenGui) then
            if (obj:IsA("TextLabel") or obj:IsA("TextButton")) and (allowHidden or isActuallyVisible(obj)) then
                local textLower = trimText(obj.Text)
                if (exactMatch and textLower == targetLower) or (not exactMatch and textLower:find(targetLower, 1, true)) then
                    return obj
                end
            end
        end
    end
    return nil
end


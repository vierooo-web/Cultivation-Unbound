                end
            end
        end

        RunService.RenderStepped:Wait()
        RunService.RenderStepped:Wait()
        RunService.RenderStepped:Wait()

        local cursorObj = nil
        local maxDelta = 0
        for obj, oldX in pairs(initialX) do
            if obj and obj.Parent then
                local dX = math.abs(obj.AbsolutePosition.X - oldX)
                if dX > 0.4 and dX > maxDelta then
                    maxDelta = dX
                    cursorObj = obj
                end

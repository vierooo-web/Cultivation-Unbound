-- SMART ZONE DETECTOR & PRECISION BUFF TELEPORT
-------------------------------------------------------------------------
do
    local function getZoneBuffCenterPosition(zoneName)
        local targetLower = zoneName:lower()
        local matchedObjects = {}

        for _, obj in pairs(Workspace:GetDescendants()) do
            local isMatch = false
            if obj:IsA("Model") or obj:IsA("BasePart") or obj:IsA("Folder") then
                if obj.Name:lower():find(targetLower, 1, true) then
                    isMatch = true
                end
            elseif (obj:IsA("TextLabel") or obj:IsA("TextBox")) and obj.Text:lower():find(targetLower, 1, true) then
                local ancestor = obj:FindFirstAncestorOfClass("Model") or obj:FindFirstAncestorWhichIsA("BasePart")
                if ancestor then table.insert(matchedObjects, ancestor) end
            elseif obj:IsA("StringValue") and obj.Value:lower():find(targetLower, 1, true) then
                if obj.Parent then table.insert(matchedObjects, obj.Parent) end
            end

            if not isMatch and (obj:IsA("Model") or obj:IsA("BasePart")) then
                pcall(function()
                    for _, attrVal in pairs(obj:GetAttributes()) do
                        if tostring(attrVal):lower():find(targetLower, 1, true) then
                            isMatch = true
                            break
                        end
                    end
                end)
            end

            if isMatch then table.insert(matchedObjects, obj) end
        end

        if #matchedObjects == 0 then return nil end

        local bestPart = nil
        local bestPriority = -1
        local largestArea = 0

        for _, matchObj in ipairs(matchedObjects) do
            local partsList = {}
            if matchObj:IsA("BasePart") then
                table.insert(partsList, matchObj)
            else
                for _, d in pairs(matchObj:GetDescendants()) do
                    if d:IsA("BasePart") then table.insert(partsList, d) end
                end
            end

            for _, p in ipairs(partsList) do
                local pName = p.Name:lower()
                local priority = 1
                if pName:find("zone") or pName:find("buff") or pName:find("area") or pName:find("hitbox") or pName:find("center") or pName:find("floor") or pName:find("pad") or pName:find("circle") then
                    priority = 3
                elseif not pName:find("sign") and not pName:find("banner") and not pName:find("wall") and not pName:find("roof") and not pName:find("pillar") then
                    priority = 2
                end

                local footprint = p.Size.X * p.Size.Z
                if priority > bestPriority or (priority == bestPriority and footprint > largestArea) then
                    bestPriority = priority
                    largestArea = footprint
                    bestPart = p
                end
            end
        end

        local rawCenterPos = nil
        if bestPart then
            rawCenterPos = bestPart.Position
        elseif matchedObjects[1]:IsA("Model") then
            local cf, _ = matchedObjects[1]:GetBoundingBox()
            rawCenterPos = cf.Position
        end

        if not rawCenterPos then return nil end

        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = {LocalPlayer.Character}

        local rayResult = Workspace:Raycast(Vector3.new(rawCenterPos.X, rawCenterPos.Y + 45, rawCenterPos.Z), Vector3.new(0, -150, 0), rayParams)
        if rayResult then
            return rayResult.Position + Vector3.new(0, 3.2, 0)
        else
            return rawCenterPos + Vector3.new(0, 3.2, 0)
        end
    end

    teleportToZoneBuffRange = function(zoneName)
        if State.isTeleportingZone then return end
        State.isTeleportingZone = true

        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local root = char:FindFirstChild("HumanoidRootPart")

        if not root then
            UI.ZoneStatusLabel.Text = "Status: Karakter belum siap!"
            State.isTeleportingZone = false
            return
        end

        UI.ZoneStatusLabel.Text = "Mencari koordinat buff zone: " .. zoneName .. "..."
        local targetPos = getZoneBuffCenterPosition(zoneName)

        if not targetPos then
            UI.ZoneStatusLabel.Text = "Zona '" .. zoneName .. "' belum ditemukan di sekitar."
            State.isTeleportingZone = false
            return
        end

        local dist = (root.Position - targetPos).Magnitude
        UI.ZoneStatusLabel.Text = string.format("Berpindah ke %s (%d studs)...", zoneName, math.round(dist))

        local duration = math.clamp(dist / math.max(State.flySpeed, 120), 0.15, 4.5)
        local bodyVel = Instance.new("BodyVelocity")
        bodyVel.Velocity = Vector3.new(0, 0, 0)
        bodyVel.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bodyVel.Parent = root

        local tween = TweenService:Create(
            root,
            TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
            {CFrame = CFrame.new(targetPos)}
        )
        tween:Play()
        tween.Completed:Wait()

        root.CFrame = CFrame.new(targetPos)
        root.Velocity = Vector3.new(0, 0, 0)
        bodyVel:Destroy()

        UI.ZoneStatusLabel.Text = "Berada di dalam jangkauan buff: " .. zoneName .. "!"
        State.isTeleportingZone = false
    end
end


            -- Harus diawali tanda '+' diikuti angka (bukan teks "+200% speed, max" atau resep "+ 1x")
            if raw:match("^%+%s*%d") then
                if raw:find("qi") and not raw:find("speed") then
                    State.lastQiPopupTick = tick()
                elseif raw:find("body") or raw:find("exp") then
                    State.lastBodyPopupTick = tick()
                end
            end
        end
    end

    task.spawn(function()
        local playerGui = LocalPlayer:WaitForChild("PlayerGui")
        playerGui.DescendantAdded:Connect(function(desc)
            pcall(onNewGuiElementAdded, desc)
        end)
    end)

    -- Mengecek apakah karakter sedang memainkan animasi kultivasi (selain animasi default Animate)
    local function isPlayingCultivationAnimation()
        local char = LocalPlayer.Character
        if not char then return false end
        local hum = char:FindFirstChildWhichIsA("Humanoid")
        local animator = hum and hum:FindFirstChildWhichIsA("Animator")
        if not animator then return false end

        local animateFolder = char:FindFirstChild("Animate")
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            if track.IsPlaying and track.WeightCurrent > 0.1 then
                local anim = track.Animation
                local isDefaultAnim = false
                if anim and animateFolder and anim:IsDescendantOf(animateFolder) then
                    isDefaultAnim = true
                end
                local tName = (track.Name or ""):lower()
                if tName == "animation1" or tName == "animation2" or tName == "idle" or tName == "walk" or tName == "run" or tName == "jump" or tName == "fall" or tName == "toolnone" then
                    isDefaultAnim = true
                end

                if not isDefaultAnim then
                    return true
                end
            end
        end
        return false
    end

    -- Mengecek mode aktif pada bar HUD bawah ("Qi · ..." atau "Body · ...")
    local function getActiveHudCultivationMode()
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if not playerGui then return nil end
        for _, obj in pairs(playerGui:GetDescendants()) do
            if obj ~= UI.ScreenGui and not obj:IsDescendantOf(UI.ScreenGui) and obj:IsA("TextLabel") and isActuallyVisible(obj) then
                local raw = obj.Text or ""
                if raw:find("Qi%s*[·%-]") then
                    return "Realm"
                elseif raw:find("Body%s*[·%-]") then
                    return "Body"
                end
            end
        end
        return nil
    end

    task.spawn(function()
        while true do
            if (State.autoRealmActive or State.autoBodyActive) and not isUserTypingOrInMenu() and not State.isTeleportingZone and not State.autoFarmActive and not State.autoKillActive then
                local char = LocalPlayer.Character
                local hum = char and char:FindFirstChildWhichIsA("Humanoid")
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local isMoving = hum and (hum.MoveDirection.Magnitude > 0.05 or (root and root.AssemblyLinearVelocity.Magnitude > 3))

                if isMoving then
                    State.lastQiPopupTick = 0
                    State.lastBodyPopupTick = 0
                else
                    -- Jangan tekan M/P jika sedang di dalam minigame Breakthrough Trial atau Alchemy Cauldron sedang terbuka
                    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
                    local busyInModal = false
                    if playerGui then
                        for _, obj in pairs(playerGui:GetDescendants()) do
                            if (obj:IsA("TextLabel") or obj:IsA("TextButton")) and isActuallyVisible(obj) then
                                local t = trimText(obj.Text)
                                if t:find("breakthrough trial", 1, true) or t:find("ring turns gold", 1, true) or t:find("stoke the fire", 1, true) then
                                    busyInModal = true
                                    break
                                end
                            end
                        end
                    end

                    if not busyInModal then
                        local now = tick()
                        local hasCultAnim = isPlayingCultivationAnimation()
                        local hudMode = getActiveHudCultivationMode()

                        if State.autoRealmActive then
                            local activeRealm = (hasCultAnim and hudMode == "Realm") or ((now - State.lastQiPopupTick) < 3.5)
                            if not activeRealm and (now - State.lastRealmKeyPress) > 2.8 then
                                State.lastRealmKeyPress = now
                                triggerKeyPress("M")
                            end
                        elseif State.autoBodyActive then
                            local activeBody = (hasCultAnim and hudMode == "Body") or ((now - State.lastBodyPopupTick) < 3.5)
                            if not activeBody and (now - State.lastBodyKeyPress) > 2.8 then
                                State.lastBodyKeyPress = now
                                triggerKeyPress("P")
                            end
                        end
                    end
                end
            end
            task.wait(0.35)
        end
    end)
end


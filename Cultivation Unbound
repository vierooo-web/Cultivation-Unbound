            local kLow = tostring(k):lower()
            if modeType == "Realm" and (kLow:find("meditat") or kLow:find("cultivat")) and v == true then
                attrCheck = true
            elseif modeType == "Body" and (kLow:find("train") or kLow:find("body") or kLow:find("exercis")) and v == true then
                attrCheck = true
            end
        end
    end)
    if attrCheck then return true end

    -- 2. Cek apakah ada indikator teks aktif di layar atau animasi khusus yang sedang berjalan
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    local animator = hum and hum:FindFirstChildWhichIsA("Animator")

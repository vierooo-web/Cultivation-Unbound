-------------------------------------------------------------------------
-- INSTANT TELEPORT & STRICT ZONE FILTER (YANG SUDAH WORK 100%)
-------------------------------------------------------------------------
do
    local function isIgnoredWorkspaceObject(obj)
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.Character and obj:IsDescendantOf(plr.Character) then
                return true
            end
        end
        local fullPathLow = obj:GetFullName():lower()
        if fullPathLow:find("leaderboard") or fullPathLow:find("shop") or fullPathLow:find("npc")
            or fullPathLow:find("portal") or fullPathLow:find("quest") or fullPathLow:find("spawn") then
            return true
        end
        return false
    end

    local function extractZoneCenterPosition(obj)
        if not obj then return nil end

        if obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
            if obj.Adornee then
                return extractZoneCenterPosition(obj.Adornee)
            end
            local anc = obj:FindFirstAncestorWhichIsA("BasePart") or obj:FindFirstAncestorOfClass("Model")
            if anc and anc ~= Workspace then
                return extractZoneCenterPosition(anc)
            end
        end

        if obj:IsA("Model") or obj:IsA("Folder") then
            local bestPart = nil
            local bestScore = -1
            local bestFootprint = 0

            for _, d in pairs(obj:GetDescendants()) do
                if d:IsA("BasePart") then
                    local pName = d.Name:lower()
                    local score = 1
                    if pName:find("zone") or pName:find("buff") or pName:find("area") or pName:find("hitbox")
                        or pName:find("center") or pName:find("circle") or pName:find("cylinder") or pName:find("floor") or pName:find("pad") then
                        score = 4
                    elseif d.Transparency > 0.25 and d.CanCollide == false and d.Size.X >= 12 and d.Size.Z >= 12 then
                        score = 3
                    elseif not pName:find("sign") and not pName:find("banner") and not pName:find("wall") and not pName:find("roof") then
                        score = 2
                    end

                    local footprint = d.Size.X * d.Size.Z
                    if score > bestScore or (score == bestScore and footprint > bestFootprint) then
                        bestScore = score
                        bestFootprint = footprint
                        bestPart = d
                    end
                end
            end

            if bestPart then return bestPart.Position end
            if obj:IsA("Model") then
                local ok, cf = pcall(function() return obj:GetPivot() end)
                if ok and cf and cf.Position.Magnitude > 1 then return cf.Position end
            end
        elseif obj:IsA("BasePart") then
            return obj.Position
        end

        return nil
    end

    local function findExactZoneInWorkspace(zoneName)
        local normTarget = normalizeName(zoneName)
        local candidates = {}

        for _, obj in pairs(Workspace:GetDescendants()) do
            if not isIgnoredWorkspaceObject(obj) then
                if obj:IsA("Model") or obj:IsA("BasePart") or obj:IsA("Folder") then
                    local objNorm = normalizeName(obj.Name)
                    if objNorm == normTarget or (objNorm:find(normTarget, 1, true) and #normTarget >= 8) then
                        local pos = extractZoneCenterPosition(obj)
                        if pos then
                            local parentLow = obj.Parent and obj.Parent.Name:lower() or ""
                            local score = (objNorm == normTarget) and 10 or 6
                            if parentLow:find("zone") or parentLow:find("area") or parentLow:find("cultivat") or parentLow:find("mapanchors") then
                                score = score + 5
                            end
                            table.insert(candidates, {Pos = pos, Score = score})
                        end
                    end

                    pcall(function()
                        for _, v in pairs(obj:GetAttributes()) do
                            if normalizeName(tostring(v)) == normTarget then
                                local pos = extractZoneCenterPosition(obj)
                                if pos then table.insert(candidates, {Pos = pos, Score = 12}) end
                            end
                        end
                    end)
                elseif obj:IsA("StringValue") and normalizeName(obj.Value) == normTarget and obj.Parent then
                    local pos = extractZoneCenterPosition(obj.Parent)
                    if pos then table.insert(candidates, {Pos = pos, Score = 11}) end
                end
            end
        end

        for _, obj in pairs(Workspace:GetDescendants()) do
            if not isIgnoredWorkspaceObject(obj) and (obj:IsA("TextLabel") or obj:IsA("TextBox")) then
                local txtNorm = normalizeName(obj.Text)
                if txtNorm == normTarget or (txtNorm:find(normTarget, 1, true) and (obj.Text:lower():find("qi") or obj.Text:lower():find("body") or obj.Text:lower():find("zone") or obj.Text:lower():find("x "))) then
                    local bGui = obj:FindFirstAncestorWhichIsA("BillboardGui") or obj:FindFirstAncestorWhichIsA("SurfaceGui")
                    if bGui then
                        local pos = extractZoneCenterPosition(bGui)
                        if pos then table.insert(candidates, {Pos = pos, Score = 9}) end
                    end
                end
            end
        end

        if #candidates == 0 then return nil end
        table.sort(candidates, function(a, b) return a.Score > b.Score end)
        return candidates[1].Pos
    end

    local function snapToGroundInsideZone(rawPos)
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = {LocalPlayer.Character}

        local rayResult = Workspace:Raycast(Vector3.new(rawPos.X, rawPos.Y + 22, rawPos.Z), Vector3.new(0, -140, 0), rayParams)
        if rayResult then
            return rayResult.Position + Vector3.new(0, 3.0, 0)
        end
        return rawPos + Vector3.new(0, 3.0, 0)
    end

    instantTeleportToZone = function(zoneName)
        if State.isTeleportingZone then return end
        State.isTeleportingZone = true

        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildWhichIsA("Humanoid")

        if not root then
            UI.ZoneStatusLabel.Text = "Status: Karakter belum siap!"
            State.isTeleportingZone = false
            return
        end

        UI.ZoneStatusLabel.Text = "Mencari koordinat " .. zoneName .. "..."
        local targetPos = State.zoneCache[zoneName] or findExactZoneInWorkspace(zoneName)

        if not targetPos then
            UI.ZoneStatusLabel.Text = "Memuat area map jauh untuk " .. zoneName .. "..."
            local origCf = root.CFrame
            local probePoints = {}

            for _, obj in pairs(Workspace:GetDescendants()) do
                if obj:IsA("Model") and not isIgnoredWorkspaceObject(obj) then
                    local ok, cf = pcall(function() return obj:GetPivot() end)
                    if ok and cf and cf.Position.Magnitude > 20 then
                        local near = false
                        for _, pt in ipairs(probePoints) do
                            if (pt - cf.Position).Magnitude < 400 then near = true break end
                        end
                        if not near then table.insert(probePoints, cf.Position) end
                    end
                end
            end

            for _, pt in ipairs(probePoints) do
                pcall(function() LocalPlayer:RequestStreamAroundAsync(pt, 1.5) end)
                root.Anchored = false
                if hum then hum.Sit = false end
                char:PivotTo(CFrame.new(pt + Vector3.new(0, 15, 0)))
                root.CFrame = CFrame.new(pt + Vector3.new(0, 15, 0))
                task.wait(0.08)
                targetPos = findExactZoneInWorkspace(zoneName)
                if targetPos then break end
            end

            if not targetPos then
                char:PivotTo(origCf)
                root.CFrame = origCf
                UI.ZoneStatusLabel.Text = "Zona '" .. zoneName .. "' belum terdeteksi."
                State.isTeleportingZone = false
                return
            end
        end

        UI.ZoneStatusLabel.Text = "Teleportasi Instan ke " .. zoneName .. "..."
        root.Anchored = false
        if hum then hum.Sit = false end

        pcall(function()
            LocalPlayer:RequestStreamAroundAsync(targetPos, 2)
        end)

        for _ = 1, 6 do
            root.Anchored = false
            root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            char:PivotTo(CFrame.new(targetPos + Vector3.new(0, 3.5, 0)))
            root.CFrame = CFrame.new(targetPos + Vector3.new(0, 3.5, 0))
            RunService.Heartbeat:Wait()
        end

        task.wait(0.18)
        local refinedPos = findExactZoneInWorkspace(zoneName) or targetPos
        local finalBuffPos = snapToGroundInsideZone(refinedPos)
        State.zoneCache[zoneName] = finalBuffPos

        for _ = 1, 8 do
            root.Anchored = false
            root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            char:PivotTo(CFrame.new(finalBuffPos))
            root.CFrame = CFrame.new(finalBuffPos)
            RunService.Heartbeat:Wait()
        end

        State.lastQiServerTick = 0
        State.lastBodyServerTick = 0
        State.lastRealmTrigger = 0
        State.lastBodyTrigger = 0

        UI.ZoneStatusLabel.Text = string.format("Berhasil Teleport ke %s! (%d, %d, %d)", zoneName, math.round(finalBuffPos.X), math.round(finalBuffPos.Y), math.round(finalBuffPos.Z))
        State.isTeleportingZone = false
    end
end


-- 5. AUTOFARM MOB & AUTO KILL PLAYER (TELEPORT + TARGET LOCK + SKILLS)
-------------------------------------------------------------------------
do
    -- Memeriksa apakah sebuah Model adalah Mob hidup yang cocok dengan pilihan
    local function isMatchingMobModel(model, targetMobName)
        if not model or not model:IsA("Model") then return false end
        if Players:GetPlayerFromCharacter(model) then return false end

        local mNameLow = model.Name:lower()
        if mNameLow:find("dummy") or Constants.FRIENDLY_NPCS[mNameLow] then
            return false
        end
        if model.Parent and model.Parent.Name == "Villagers" then
            return false
        end

        local hum = model:FindFirstChildWhichIsA("Humanoid")
        local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
        if not hum or not root or hum.Health <= 0 then
            return false
        end

        local targetLow = targetMobName:lower()

        -- Kumpulkan semua teks identitas mob (Model.Name, DisplayName, Parent.Name, BillboardGui TextLabel, Attributes)
        local infoParts = {mNameLow, (hum.DisplayName or ""):lower()}
        if model.Parent and model.Parent ~= Workspace then
            table.insert(infoParts, model.Parent.Name:lower())
        end
        pcall(function()
            for _, v in pairs(model:GetAttributes()) do
                table.insert(infoParts, tostring(v):lower())
            end
        end)
        for _, d in pairs(model:GetDescendants()) do
            if d:IsA("TextLabel") then
                table.insert(infoParts, (d.Text or ""):lower())
            end
        end

        local combinedInfo = table.concat(infoParts, " ")

        -- Pencocokan spesifik agar "Bandit" biasa tidak salah mengambil "Bandit Captain"
        if targetLow == "bandit" then
            return combinedInfo:find("bandit", 1, true) and not combinedInfo:find("captain", 1, true)
        elseif targetLow == "world boss" then
            return (model.Parent and model.Parent.Name == "WorldBoss") or combinedInfo:find("boss", 1, true) or combinedInfo:find("titan", 1, true) or combinedInfo:find("ancestor", 1, true)
        else
            return combinedInfo:find(targetLow, 1, true) ~= nil
        end
    end

    -- Mencari Mob terdekat yang masih hidup sesuai pilihan
    local function findLivingMobTarget(mobName)
        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local myPos = myRoot and myRoot.Position or Vector3.new(0, 0, 0)

        local bestMob = nil
        local shortestDist = math.huge

        -- Prioritaskan folder BanditCamp, CultivatorCamps, dan WorldBoss terlebih dahulu
        local priorityFolders = {
            Workspace:FindFirstChild("BanditCamp"),
            Workspace:FindFirstChild("CultivatorCamps"),
            Workspace:FindFirstChild("WorldBoss"),
            Workspace
        }

        for _, folder in ipairs(priorityFolders) do
            if folder then
                local list = (folder == Workspace) and folder:GetChildren() or folder:GetDescendants()
                for _, obj in pairs(list) do
                    if obj:IsA("Model") and isMatchingMobModel(obj, mobName) then
                        local r = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
                        if r then
                            local d = (r.Position - myPos).Magnitude
                            if d < shortestDist then
                                shortestDist = d
                                bestMob = obj
                            end
                        end
                    end
                end
                if bestMob then return bestMob end
            end
        end

        return nil
    end

    -- Jika kemah mob berada jauh dan belum ter-stream, teleport ke titik kemah / NPC penjaga kemah (Garrick/Kess/Lei/Huang/Shen/Mei)
    local function streamMobCampArea(mobName)
        local targetLow = mobName:lower()
        local campTargetObj = nil

        if targetLow:find("bandit") then
            campTargetObj = Workspace:FindFirstChild("Garrick")
                or Workspace:FindFirstChild("Kess")
                or Workspace:FindFirstChild("BanditCamp")
        elseif targetLow:find("outer") then
            campTargetObj = Workspace:FindFirstChild("Lei") or Workspace:FindFirstChild("CultivatorCamps")
        elseif targetLow:find("inner") then
            campTargetObj = Workspace:FindFirstChild("Huang") or Workspace:FindFirstChild("CultivatorCamps")
        elseif targetLow:find("core") then
            campTargetObj = Workspace:FindFirstChild("Shen") or Workspace:FindFirstChild("CultivatorCamps")
        elseif targetLow:find("elder") then
            campTargetObj = Workspace:FindFirstChild("Mei") or Workspace:FindFirstChild("CultivatorCamps")
        elseif targetLow:find("boss") then
            campTargetObj = Workspace:FindFirstChild("WorldBossArena") or Workspace:FindFirstChild("WorldBoss")
        end

        if campTargetObj then
            local pos = nil
            pcall(function()
                if campTargetObj:IsA("BasePart") then
                    pos = campTargetObj.Position
                elseif campTargetObj:IsA("Model") then
                    pos = campTargetObj:GetPivot().Position
                elseif campTargetObj:IsA("Folder") and #campTargetObj:GetChildren() > 0 then
                    local firstChild = campTargetObj:GetChildren()[1]
                    if firstChild:IsA("BasePart") then pos = firstChild.Position
                    elseif firstChild:IsA("Model") then pos = firstChild:GetPivot().Position end
                end
            end)

            if pos and pos.Magnitude > 1 then
                pcall(function() LocalPlayer:RequestStreamAroundAsync(pos, 2) end)
                local myChar = LocalPlayer.Character
                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                if myChar and myRoot then
                    myRoot.Anchored = false
                    myChar:PivotTo(CFrame.new(pos + Vector3.new(0, 6, 0)))
                    myRoot.CFrame = CFrame.new(pos + Vector3.new(0, 6, 0))
                end
            end
        end
    end

    -- RenderStepped Lock: Mengunci posisi karakter tepat di belakang Target (Mob atau Player)
    RunService.RenderStepped:Connect(function()
        if State.isTeleportingZone then return end

        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end

        -- Prioritas 1: Auto Kill Player
        if State.autoKillActive and State.selectedTargetPlayerName ~= "None" then
            local targetPlr = Players:FindFirstChild(State.selectedTargetPlayerName)
            if targetPlr and targetPlr.Character then
                local targetRoot = targetPlr.Character:FindFirstChild("HumanoidRootPart")
                local targetHum = targetPlr.Character:FindFirstChildWhichIsA("Humanoid")
                if targetRoot and (not targetHum or targetHum.Health > 0) then
                    local lockPos = (targetRoot.CFrame * CFrame.new(0, 0, 3.5)).Position
                    myRoot.CFrame = CFrame.new(lockPos, targetRoot.Position)
                    myRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    return
                end
            end
        end

        -- Prioritas 2: Autofarm Mob (Teleport & Auto Lock)
        if State.autoMobActive and State.currentMobTarget then
            local mob = State.currentMobTarget
            local mobRoot = mob:FindFirstChild("HumanoidRootPart") or mob.PrimaryPart
            local mobHum = mob:FindFirstChildWhichIsA("Humanoid")
            if mob.Parent and mobRoot and mobHum and mobHum.Health > 0 then
                local lockPos = (mobRoot.CFrame * CFrame.new(0, 0, 3.8)).Position
                myRoot.Anchored = false
                myRoot.CFrame = CFrame.new(lockPos, mobRoot.Position)
                myRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            else
                State.currentMobTarget = nil
            end
        end
    end)

    -- Loop Pencari Target Mob & Eksekusi Serangan Pedang + Skill
    task.spawn(function()
        while true do
            local isKillingPlayer = (State.autoKillActive and State.selectedTargetPlayerName ~= "None")
            local isFarmingMob = State.autoMobActive

            if (isKillingPlayer or isFarmingMob) and not isUserTypingOrInMenu() and not State.isTeleportingZone then
                local hasValidTarget = false

                if isKillingPlayer then
                    local targetPlr = Players:FindFirstChild(State.selectedTargetPlayerName)
                    if targetPlr and targetPlr.Character then
                        local tHum = targetPlr.Character:FindFirstChildWhichIsA("Humanoid")
                        if not tHum or tHum.Health > 0 then
                            hasValidTarget = true
                        end
                    end
                elseif isFarmingMob then
                    -- Cek apakah target mob saat ini masih hidup
                    if State.currentMobTarget then
                        local mHum = State.currentMobTarget:FindFirstChildWhichIsA("Humanoid")
                        if not State.currentMobTarget.Parent or not mHum or mHum.Health <= 0 then
                            State.currentMobTarget = nil
                        end
                    end

                    -- Cari target mob baru jika belum ada
                    if not State.currentMobTarget then
                        State.currentMobTarget = findLivingMobTarget(State.selectedMob)
                        if not State.currentMobTarget then
                            streamMobCampArea(State.selectedMob)
                            task.wait(0.25)
                            State.currentMobTarget = findLivingMobTarget(State.selectedMob)
                        end
                    end

                    if State.currentMobTarget then
                        hasValidTarget = true
                    end
                end

                -- Jika ada target aktif, gunakan pedang & kombo skill otomatis
                if hasValidTarget then
                    local char = LocalPlayer.Character
                    if char then
                        local hum = char:FindFirstChildWhichIsA("Humanoid")
                        local backpack = LocalPlayer:FindFirstChild("Backpack")
                        local equippedTool = char:FindFirstChildWhichIsA("Tool")
                        if not equippedTool and backpack and hum then
                            for _, item in pairs(backpack:GetChildren()) do
                                if item:IsA("Tool") then
                                    hum:EquipTool(item)
                                    equippedTool = item
                                    break
                                end
                            end
                        end
                        if equippedTool then
                            pcall(function() equippedTool:Activate() end)
                        end
                        pcall(function()
                            if CultivationEvents then
                                if CultivationEvents:FindFirstChild("WeaponSwingEvent") then
                                    CultivationEvents.WeaponSwingEvent:FireServer()
                                end
                                if CultivationEvents:FindFirstChild("CombatHit") then
                                    CultivationEvents.CombatHit:FireServer()
                                end
                            end
                            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
                            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
                        end)
                    end

                    if State.autoSkillKillActive and (tick() - State.lastSkillCycleTime >= 0.35) then
                        State.lastSkillCycleTime = tick()
                        local keyToPress = Constants.COMBAT_SKILL_KEYS[State.skillIndex]
                        State.skillIndex = (State.skillIndex % #Constants.COMBAT_SKILL_KEYS) + 1
                        pcall(function()
                            VirtualInputManager:SendKeyEvent(true, keyToPress, false, game)
                            task.wait(0.02)
                            VirtualInputManager:SendKeyEvent(false, keyToPress, false, game)
                        end)
                    end
                end
                task.wait(0.12)
            else
                task.wait(0.35)
            end
        end
    end)
end

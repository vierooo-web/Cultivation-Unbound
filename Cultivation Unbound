-------------------------------------------------------------------------
-- Mencari titik tengah presisi di dalam radius buff Zone
local function getZoneBuffCenterPosition(zoneName)
    local targetLower = zoneName:lower()
    local matchedObjects = {}

    -- 1. Pindai seluruh objek, BillboardGui/TextLabel, dan Atribut di Workspace
    for _, obj in pairs(Workspace:GetDescendants()) do
        local isMatch = false

        if obj:IsA("Model") or obj:IsA("BasePart") or obj:IsA("Folder") then
            if obj.Name:lower():find(targetLower, 1, true) then
                isMatch = true
            end
        elseif (obj:IsA("TextLabel") or obj:IsA("TextBox")) and obj.Text:lower():find(targetLower, 1, true) then
            local ancestor = obj:FindFirstAncestorOfClass("Model") or obj:FindFirstAncestorWhichIsA("BasePart")
            if ancestor then
                table.insert(matchedObjects, ancestor)
            end
        elseif obj:IsA("StringValue") and obj.Value:lower():find(targetLower, 1, true) then
            if obj.Parent then
                table.insert(matchedObjects, obj.Parent)
            end
        end

        if not isMatch and (obj:IsA("Model") or obj:IsA("BasePart")) then
            pcall(function()
                for _, attrVal in pairs(obj:GetAttributes()) do
                    if tostring(attrVal):lower():find(targetLower, 1, true) then
                        isMatch = true
                        break
                    end
                end
            end)
        end

        if isMatch then
            table.insert(matchedObjects, obj)
        end
    end

    if #matchedObjects == 0 then
        return nil
    end

    -- 2. Cari bagian lantai / hitbox / area tengah buff dari objek zona yang ditemukan
    local bestPart = nil
    local bestPriority = -1
    local largestArea = 0

    for _, matchObj in ipairs(matchedObjects) do
        local partsList = {}
        if matchObj:IsA("BasePart") then
            table.insert(partsList, matchObj)
        else
            for _, d in pairs(matchObj:GetDescendants()) do
                if d:IsA("BasePart") then
                    table.insert(partsList, d)
                end
            end
        end

        for _, p in ipairs(partsList) do
            local pName = p.Name:lower()
            local priority = 1
            if pName:find("zone") or pName:find("buff") or pName:find("area") or pName:find("hitbox") or pName:find("center") or pName:find("floor") or pName:find("pad") or pName:find("circle") then
                priority = 3
            elseif not pName:find("sign") and not pName:find("banner") and not pName:find("wall") and not pName:find("roof") and not pName:find("pillar") then
                priority = 2
            end

            local horizontalFootprint = p.Size.X * p.Size.Z
            if priority > bestPriority or (priority == bestPriority and horizontalFootprint > largestArea) then
                bestPriority = priority
                largestArea = horizontalFootprint
                bestPart = p
            end
        end
    end

    local rawCenterPos = nil
    if bestPart then
        rawCenterPos = bestPart.Position
    elseif matchedObjects[1]:IsA("Model") then
        local cf, _ = matchedObjects[1]:GetBoundingBox()
        rawCenterPos = cf.Position
    end

    if not rawCenterPos then
        return nil
    end

    -- 3. Raycast ke lantai tepat di titik tengah zona agar karakter berdiri pas di dalam jangkauan buff (bukan melayang di atas papan nama)
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = {LocalPlayer.Character}

    local rayOrigin = Vector3.new(rawCenterPos.X, rawCenterPos.Y + 45, rawCenterPos.Z)
    local rayDirection = Vector3.new(0, -150, 0)
    local rayResult = Workspace:Raycast(rayOrigin, rayDirection, rayParams)

    if rayResult then
        return rayResult.Position + Vector3.new(0, 3.2, 0)
    else
        return rawCenterPos + Vector3.new(0, 3.2, 0)
    end
end

local isTeleportingZone = false
local function teleportToZoneBuffRange(zoneName)
    if isTeleportingZone then return end
    isTeleportingZone = true

    Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    HumanoidRootPart = Character:FindFirstChild("HumanoidRootPart")

    if not HumanoidRootPart then
        ZoneStatusLabel.Text = "Status: Karakter belum siap!"
        isTeleportingZone = false
        return
    end

    ZoneStatusLabel.Text = "Mencari koordinat buff zone: " .. zoneName .. "..."
    local targetPos = getZoneBuffCenterPosition(zoneName)

    if not targetPos then
        ZoneStatusLabel.Text = "Zona '" .. zoneName .. "' belum ter-render. Mendekati area..."
        isTeleportingZone = false
        return
    end

    local dist = (HumanoidRootPart.Position - targetPos).Magnitude
    ZoneStatusLabel.Text = string.format("Berpindah ke %s (Jarak: %d studs)...", zoneName, math.round(dist))

    -- Jika jarak dekat (< 250 studs) atau instan, gunakan Tween + CFrame presisi tepat di tengah buff
    local duration = math.clamp(dist / math.max(FLY_SPEED, 120), 0.15, 4.5)
    local bodyVel = Instance.new("BodyVelocity")
    bodyVel.Velocity = Vector3.new(0, 0, 0)
    bodyVel.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bodyVel.Parent = HumanoidRootPart

    local tween = TweenService:Create(
        HumanoidRootPart,
        TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
        {CFrame = CFrame.new(targetPos)}
    )
    tween:Play()
    tween.Completed:Wait()

    -- Pastikan posisi akhir terkunci tepat di titik tengah lantai buff
    HumanoidRootPart.CFrame = CFrame.new(targetPos)
    HumanoidRootPart.Velocity = Vector3.new(0, 0, 0)
    bodyVel:Destroy()

    ZoneStatusLabel.Text = "Berhasil berada di dalam jangkauan buff: " .. zoneName .. "!"
    isTeleportingZone = false
end


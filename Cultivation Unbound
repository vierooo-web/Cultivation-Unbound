        end

        -- Cek apakah UI Cauldron sudah terbuka di layar
        if findElementByText("brew", true) or findElementByText("stoke", true) or findElementByText("claim", true) or findElementByText("choose a herb", false) then
            return true
        end

        if tick() - lastCauldronOpenTick < 1.5 then
            return false
        end
        lastCauldronOpenTick = tick()

        if cauldronMesh then
            local prompt = cauldronMesh:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt then
                pcall(function()
                    prompt.MaxActivationDistance = math.huge
                    prompt.RequiresLineOfSight = false
                    if fireproximityprompt then
                        fireproximityprompt(prompt)
                    else
                        prompt:InputHoldBegin()
                        task.wait(0.1)
                        prompt:InputHoldEnd()
                    end
                end)
            end
        end
        return false
    end

    -- Fungsi asli pemilihan Herb (Prioritas 1000Yr > 100Yr > 10Yr > 1Yr) yang sudah terbukti bekerja
    local function selectBestHerbFromModal(herbName)
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if not playerGui then return false end
        
        local herbLower = trimText(herbName)
        local candidates = {}
        
        for _, obj in pairs(playerGui:GetDescendants()) do
            if not obj:IsDescendantOf(UI.ScreenGui) and (obj:IsA("TextLabel") or obj:IsA("TextButton")) and isActuallyVisible(obj) then
                if trimText(obj.Text) == herbLower then
                    local row = obj.Parent
                    for _ = 1, 3 do
                        if row then
                            local chooseBtn = nil
                            local yearScore = 0
                            local quantity = 1
                            
                            for _, child in pairs(row:GetDescendants()) do
                                if (child:IsA("TextLabel") or child:IsA("TextButton")) then
                                    local txt = trimText(child.Text)
                                    if txt == "choose" then
                                        chooseBtn = child
                                    elseif txt:find("year") then
                                        for _, yrData in ipairs(Constants.HERB_YEAR_PRIORITY) do
                                            if txt:find(yrData.pattern, 1, true) then
                                                yearScore = math.max(yearScore, yrData.score)
                                                break
                                            end
                                        end
                                    elseif txt:match("^x%d+") then
                                        local num = tonumber(txt:match("%d+"))
                                        if num then quantity = num end
                                    end
                                end
                            end
                            
                            if chooseBtn and quantity > 0 then
                                table.insert(candidates, {
                                    Row = row,
                                    ChooseButton = chooseBtn,
                                    Score = yearScore,
                                    Quantity = quantity
                                })
                                break
                            end
                            row = row.Parent
                        end
                    end
                end
            end
        end
        
        if #candidates == 0 then return false end
        
        table.sort(candidates, function(a, b)
            return a.Score > b.Score
        end)
        
        local bestCandidate = candidates[1]
        local targetBtn = bestCandidate.ChooseButton
        local targetRow = bestCandidate.Row
        
        local scrollFrame = targetRow:FindFirstAncestorWhichIsA("ScrollingFrame")
        if scrollFrame then
            local sfPosY = scrollFrame.AbsolutePosition.Y
            local sfSizeY = scrollFrame.AbsoluteSize.Y
            local rowPosY = targetRow.AbsolutePosition.Y
            local rowSizeY = targetRow.AbsoluteSize.Y
            
            if rowPosY < sfPosY or (rowPosY + rowSizeY) > (sfPosY + sfSizeY) then
                local relativeOffset = rowPosY - sfPosY
                scrollFrame.CanvasPosition = Vector2.new(
                    scrollFrame.CanvasPosition.X,
                    math.max(0, scrollFrame.CanvasPosition.Y + relativeOffset - (sfSizeY / 3))
                )
                task.wait(0.12)
            end
        end
        
        clickGuiElement(targetBtn, false, false)
        return true
    end

    -- Fungsi asli Minigame Stoke the Fire yang sudah bekerja
    local function handleStokeMinigame(stokeBtnObj)
        local modalContainer = stokeBtnObj.Parent
        while modalContainer and modalContainer ~= LocalPlayer.PlayerGui and modalContainer.AbsoluteSize.Y < 130 do
            modalContainer = modalContainer.Parent
        end
        if not modalContainer then return end

        local stokeY = stokeBtnObj.AbsolutePosition.Y
        local initialX = {}

        for _, obj in pairs(modalContainer:GetDescendants()) do
            if obj:IsA("GuiObject") and isActuallyVisible(obj) and obj.AbsolutePosition.Y < stokeY then
                if obj.AbsoluteSize.X < 180 and obj.AbsoluteSize.Y <= 60 then
                    initialX[obj] = obj.AbsolutePosition.X
                end
            end
        end

        RunService.RenderStepped:Wait()
        RunService.RenderStepped:Wait()
        RunService.RenderStepped:Wait()

        local cursorObj = nil
        local maxDelta = 0
        for obj, oldX in pairs(initialX) do
            if obj and obj.Parent then
                local dX = math.abs(obj.AbsolutePosition.X - oldX)
                if dX > 0.4 and dX > maxDelta then
                    maxDelta = dX
                    cursorObj = obj
                end
            end
        end

        local targetZoneObj = nil
        local barTrackObj = nil
        local refY = cursorObj and (cursorObj.AbsolutePosition.Y + cursorObj.AbsoluteSize.Y / 2) or (stokeY - 45)

        for _, obj in pairs(modalContainer:GetDescendants()) do
            if obj:IsA("GuiObject") and isActuallyVisible(obj) and obj ~= cursorObj and (not cursorObj or not obj:IsDescendantOf(cursorObj)) then
                local centerY = obj.AbsolutePosition.Y + (obj.AbsoluteSize.Y / 2)
                if math.abs(centerY - refY) < 35 then
                    if obj.AbsoluteSize.X >= 180 and obj.AbsoluteSize.Y <= 50 then
                        if not barTrackObj or obj.AbsoluteSize.X > barTrackObj.AbsoluteSize.X then
                            barTrackObj = obj
                        end
                    elseif obj.AbsoluteSize.X >= 6 and obj.AbsoluteSize.X <= 90 and obj.AbsoluteSize.Y <= 45 then
                        local dX = initialX[obj] and math.abs(obj.AbsolutePosition.X - initialX[obj]) or 0
                        if dX < 0.2 then
                            if not targetZoneObj or obj.AbsoluteSize.X < targetZoneObj.AbsoluteSize.X then
                                targetZoneObj = obj
                            end
                        end
                    end
                end
            end
        end

        local startTime = tick()
        local prevX = cursorObj and (cursorObj.AbsolutePosition.X + cursorObj.AbsoluteSize.X / 2) or nil

        while State.autoPillActive and isActuallyVisible(stokeBtnObj) and (tick() - startTime < 4.0) do
            if cursorObj then
                local curCenter = cursorObj.AbsolutePosition.X + (cursorObj.AbsoluteSize.X / 2)
                local velX = prevX and (curCenter - prevX) or 0
                prevX = curCenter
                local predictedX = curCenter + (velX * 1.15)

                local zMin, zMax
                if targetZoneObj then
                    local zPos = targetZoneObj.AbsolutePosition.X
                    local zSize = targetZoneObj.AbsoluteSize.X
                    local pad = math.min(zSize * 0.2, 6)
                    zMin = zPos + pad
                    zMax = (zPos + zSize) - pad
                elseif barTrackObj then
                    local bPos = barTrackObj.AbsolutePosition.X
                    local bSize = barTrackObj.AbsoluteSize.X
                    zMin = bPos + (bSize * 0.46)
                    zMax = bPos + (bSize * 0.54)
                end

                if zMin and zMax then
                    if (predictedX >= zMin and predictedX <= zMax) or (curCenter >= zMin and curCenter <= zMax) then
                        clickGuiElement(stokeBtnObj, true, false)
                        break
                    end
                end
            end
            RunService.RenderStepped:Wait()
        end
    end

    -- Loop Utama Auto Create Pills (Kode Lama + Buka Cauldron Anywhere)
    while true do
        if State.autoPillActive and not isUserTypingOrInMenu() then
            openCauldronAnywhereIfNeeded()

            local claimObj = findElementByText("claim", true)
            if claimObj then
                clickGuiElement(claimObj, false, false)
                task.wait(0.5)
            else
                local stokeObj = findElementByText("stoke", true)
                if stokeObj then
                    handleStokeMinigame(stokeObj)
                    task.wait(0.35)
                else
                    local addHerbObj = findElementByText("add herb", true)
                    local brewObj = findElementByText("brew", true)
                    
                    if brewObj then
                        local backObj = findElementByText("back", true)
                        if backObj then
                            clickGuiElement(backObj, false, false)
                            task.wait(0.3)
                        end
                        
                        local recipe = Constants.PILL_RECIPES[State.selectedPill]
                        if recipe and addHerbObj then
                            for slotIdx = 1, 3 do
                                if not State.autoPillActive or isUserTypingOrInMenu() then break end
                                
                                local currentAddHerb = findElementByText("add herb", true)
                                if currentAddHerb then
                                    clickGuiElement(currentAddHerb, false, false)
                                    task.wait(0.38)
                                    
                                    local targetHerbName = recipe[slotIdx]
                                    local chosen = selectBestHerbFromModal(targetHerbName)
                                    task.wait(0.38)
                                    
                                    if not chosen then
                                        local backBtn = findElementByText("back", true)
                                        if backBtn then clickGuiElement(backBtn, false, false) end
                                        break
                                    end
                                end
                            end
                            
                            task.wait(0.2)
                            local finalBrewObj = findElementByText("brew", true)
                            if finalBrewObj and not findElementByText("add herb", true) then
                                clickGuiElement(finalBrewObj, false, false)
                                task.wait(0.7)
                            end
                        elseif not addHerbObj then
                            clickGuiElement(brewObj, false, false)
                            task.wait(0.7)
                        end
                    end
                end
            end
        end
        task.wait(0.2)
    end
end)


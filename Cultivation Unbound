                    slots[i].Box = slotBox

                    for _, ch in pairs(slotBox:GetDescendants()) do
                        if (ch:IsA("TextLabel") or ch:IsA("TextButton")) and isActuallyVisible(ch) then
                            local t = trimText(ch.Text)
                            if t == "add herb" then

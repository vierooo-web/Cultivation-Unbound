local function cleanBlacklist()
    local currentTime = tick()
    for obj, timeAdded in pairs(harvestedBlacklist) do
        if currentTime - timeAdded > BLACKLIST_DURATION then
            harvestedBlacklist[obj] = nil
        end
    end
end

local function getValidPrompt(object)
    local prompt = object:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt and prompt.Enabled and prompt.Parent then
        return prompt
    end
    if object.Parent then
        local parentPrompt = object.Parent:FindFirstChildWhichIsA("ProximityPrompt", true)
        if parentPrompt and parentPrompt.Enabled then
            return parentPrompt
        end
    end
    return nil
end

local function getHerbLevelScore(obj, prompt)
    local score = 1
    local textsToInspect = {obj.Name}

    if obj.Parent and obj.Parent ~= Workspace then
        table.insert(textsToInspect, obj.Parent.Name)
    end
    if prompt then
        table.insert(textsToInspect, prompt.ObjectText or "")
        table.insert(textsToInspect, prompt.ActionText or "")
    end

    pcall(function()
        for k, v in pairs(obj:GetAttributes()) do
            table.insert(textsToInspect, tostring(k) .. " " .. tostring(v))
        end
    end)

    for _, desc in pairs(obj:GetDescendants()) do
        if desc:IsA("TextLabel") then
            table.insert(textsToInspect, desc.Text)
        end
    end

    local combined = table.concat(textsToInspect, " "):lower()
    for _, yrData in ipairs(HERB_YEAR_PRIORITY) do
        if combined:find(yrData.pattern, 1, true) then
            score = math.max(score, yrData.score)
            break
        end
    end
    return score
end

local function getBestAndClosestHerb()
    cleanBlacklist()
    local bestHerb = nil
    local highestScore = -1
    local shortestDistance = math.huge
    
    for _, obj in pairs(Workspace:GetDescendants()) do
        if not harvestedBlacklist[obj] and (obj:IsA("BasePart") or obj:IsA("Model")) then
            if obj.Name:lower():find(selectedHerb:lower()) then
                local partToTarget = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
                
                if partToTarget then
                    local prompt = getValidPrompt(obj)
                    
                    if prompt then
                        local levelScore = getHerbLevelScore(obj, prompt)
                        local distance = (HumanoidRootPart.Position - partToTarget.Position).Magnitude
                        
                        if (levelScore > highestScore) or (levelScore == highestScore and distance < shortestDistance) then
                            highestScore = levelScore
                            shortestDistance = distance
                            bestHerb = {
                                Object = obj,
                                Part = partToTarget,
                                Prompt = prompt,
                                Score = levelScore
                            }
                        end
                    else
                        harvestedBlacklist[obj] = tick()
                    end
                end
            end
        end
    end
    return bestHerb
end

local function flyToTarget(targetPart)
    local distance = (HumanoidRootPart.Position - targetPart.Position).Magnitude
    local duration = distance / FLY_SPEED
    
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    local goal = {CFrame = targetPart.CFrame * CFrame.new(0, 3, 0)}
    local tween = TweenService:Create(HumanoidRootPart, tweenInfo, goal)
    
    local bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.Velocity = Vector3.new(0, 0, 0)
    bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bodyVelocity.Parent = HumanoidRootPart
    
    tween:Play()
    
    local completed = false
    local connection
    connection = tween.Completed:Connect(function()
        completed = true
    end)
    
    while not completed and autoFarmActive do
        task.wait(0.08)
    end
    
    if not autoFarmActive then
        tween:Cancel()
    end
    
    if connection then connection:Disconnect() end
    bodyVelocity:Destroy()
end

local function collectHerb(herbData)
    if herbData.Prompt and herbData.Prompt.Enabled then
        if fireproximityprompt then
            fireproximityprompt(herbData.Prompt)
        else
            herbData.Prompt:InputHoldBegin()
            task.wait(herbData.Prompt.HoldDuration or 0.5)
            herbData.Prompt:InputHoldEnd()
        end
    end
end

task.spawn(function()
    while true do
        if autoFarmActive then
            Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
            HumanoidRootPart = Character:FindFirstChild("HumanoidRootPart")
            
            if HumanoidRootPart then
                local targetData = getBestAndClosestHerb()
                
                if targetData and autoFarmActive then
                    if targetData.Prompt and targetData.Prompt.Enabled then
                        flyToTarget(targetData.Part)
                        
                        if autoFarmActive then
                            collectHerb(targetData)
                            harvestedBlacklist[targetData.Object] = tick()
                            task.wait(WAITING_TIME_AT_HERB)
                        end
                    else
                        harvestedBlacklist[targetData.Object] = tick()
                    end
                else
                    task.wait(1.2)
                end
            else
                task.wait(1)
            end
        else
            task.wait(0.4)
        end
    end
end)


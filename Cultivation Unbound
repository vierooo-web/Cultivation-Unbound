local function updateSpeed(val)
    FLY_SPEED = math.clamp(math.round(val), MIN_SPEED, MAX_SPEED)
    Config.flySpeed = FLY_SPEED
    SpeedInputBox.Text = tostring(FLY_SPEED)
    local scale = (FLY_SPEED - MIN_SPEED) / (MAX_SPEED - MIN_SPEED)
    SliderFill.Size = UDim2.new(scale, 0, 1, 0)
    saveConfig()
end


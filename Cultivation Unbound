-- AUTO REALM (KEY M) & AUTO BODY (KEY P) - ANTI-STOP ACTIVITY TRACKER
-------------------------------------------------------------------------
do
    -- Memantau setiap popup kenaikan "+... Qi" dan "+... Exp" secara real-time
    local function checkGainText(obj)
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            local txt = obj.Text or ""
            if txt:find("%+") then
                local low = txt:lower()
                if low:find("qi") then
                    State.lastQiGainTick = tick()
                elseif low:find("exp") or low:find("body") then
                    State.lastBodyGainTick = tick()
                end
            end
        end
    end

    task.spawn(function()
        local playerGui = LocalPlayer:WaitForChild("PlayerGui")
        playerGui.DescendantAdded:Connect(function(desc)
            task.defer(function()
                pcall(checkGainText, desc)
            end)
        end)
    end)

    -- Mengecek apakah karakter sedang aktif kultivasi (berdasarkan Popup Gain, Perubahan Bar, atau Aura Partikel)
    local function isCultivationActiveNow(modeType)
        local now = tick()

        -- 1. Jika dalam 4.2 detik terakhir muncul popup "+... Qi" (untuk Realm) atau "+... Exp" (untuk Body), berarti 100% sedang aktif!
        if modeType == "Realm" and (now - State.lastQiGainTick) < 4.2 then
            return true
        elseif modeType == "Body" and (now - State.lastBodyGainTick) < 4.2 then
            return true
        end

        -- 2. Pindai teks popup "+Qi" / "+Exp" yang masih terlihat di layar saat ini
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if playerGui then
            for _, obj in pairs(playerGui:GetDescendants()) do
                if (obj:IsA("TextLabel") or obj:IsA("TextButton")) and isActuallyVisible(obj) then
                    local raw = obj.Text or ""
                    if raw:find("^%s*%+[%d%.%,kKmMbB]+%s+Qi") then
                        State.lastQiGainTick = now
                        if modeType == "Realm" then return true end
                    elseif raw:find("^%s*%+[%d%.%,kKmMbB]+%s+Exp") then
                        State.lastBodyGainTick = now
                        if modeType == "Body" then return true end
                    end
                end
            end
        end

        -- 3. Cek apakah ada ParticleEmitter / Beam aura kultivasi yang menyala pada karakter
        local char = LocalPlayer.Character
        if char then
            for _, desc in pairs(char:GetDescendants()) do
                if (desc:IsA("ParticleEmitter") or desc:IsA("Beam")) and desc.Enabled then
                    local n = (desc.Name .. " " .. (desc.Parent and desc.Parent.Name or "")):lower()
                    if modeType == "Realm" and (n:find("qi") or n:find("meditat") or n:find("aura") or n:find("cultivat") or n:find("purple")) then
                        return true
                    elseif modeType == "Body" and (n:find("body") or n:find("train") or n:find("aura") or n:find("orange") or n:find(" sweat")) then
                        return true
                    end
                end
            end
        end

        return false
    end

    task.spawn(function()
        while true do
            if (State.autoRealmActive or State.autoBodyActive) and not isUserTypingOrInMenu() and not State.isTeleportingZone and not State.autoFarmActive and not State.autoKillActive then
                local char = LocalPlayer.Character
                local hum = char and char:FindFirstChildWhichIsA("Humanoid")
                local isMoving = hum and (hum.MoveDirection.Magnitude > 0.05)

                if isMoving then
                    -- Jika pemain sengaja berjalan manual, reset timer agar setelah berhenti berjalan otomatis lanjut kultivasi
                    State.lastQiGainTick = 0
                    State.lastBodyGainTick = 0
                else
                    -- Pastikan tidak sedang di dalam minigame Breakthrough Trial
                    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
                    local inTrial = false
                    if playerGui then
                        for _, obj in pairs(playerGui:GetDescendants()) do
                            if (obj:IsA("TextLabel") or obj:IsA("TextButton")) and isActuallyVisible(obj) then
                                local t = trimText(obj.Text)
                                if t:find("breakthrough trial", 1, true) or t:find("ring turns gold", 1, true) then
                                    inTrial = true
                                    break
                                end
                            end
                        end
                    end

                    if not inTrial then
                        local now = tick()

                        -- AUTO REALM (KEY M): Hanya tekan M jika kultivasi Qi benar-benar sedang berhenti & sudah lewat masa tunggu 4.5 detik
                        if State.autoRealmActive then
                            if not isCultivationActiveNow("Realm") and (now - State.lastRealmKeyPress > 4.5) then
                                State.lastRealmKeyPress = now
                                triggerKeyPress("M")
                            end
                        end

                        -- AUTO BODY (KEY P): Hanya tekan P jika latihan Body benar-benar sedang berhenti & sudah lewat masa tunggu 4.5 detik
                        if State.autoBodyActive then
                            if not isCultivationActiveNow("Body") and (now - State.lastBodyKeyPress > 4.5) then
                                State.lastBodyKeyPress = now
                                triggerKeyPress("P")
                            end
                        end
                    end
                end
            end
            task.wait(0.6)
        end
    end)
end


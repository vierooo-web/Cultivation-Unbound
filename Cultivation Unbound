task.spawn(function()
    local lastCauldronPromptTime = 0

    local function findVisibleTextElement(targetStr, exactMatch)
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if not playerGui then return nil end
        local targetLower = trimText(targetStr)

        for _, obj in pairs(playerGui:GetDescendants()) do
            if obj ~= UI.ScreenGui and not obj:IsDescendantOf(UI.ScreenGui) then
                if (obj:IsA("TextLabel") or obj:IsA("TextButton")) and isActuallyVisible(obj) then
                    local textLower = trimText(obj.Text)
                    if (exactMatch and textLower == targetLower) or (not exactMatch and textLower:find(targetLower, 1, true)) then
                        return obj
                    end
                end
            end
        end
        return nil
    end

    -- Membuka Cauldron secara halus tanpa merusak sub-frame modal "Choose a herb"
    local function openCauldronIfClosed()
        local isOpen = findVisibleTextElement("alchemy cauldron", false)
            or findVisibleTextElement("choose a herb", false)
            or findVisibleTextElement("stoke", true)

        if isOpen then return true end

        if tick() - lastCauldronPromptTime < 2.0 then return false end
        lastCauldronPromptTime = tick()

        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") then
                local objText = (obj.ObjectText .. " " .. obj.ActionText .. " " .. obj.Parent.Name):lower()
                if objText:find("cauldron") or objText:find("brew") or objText:find("alchemy") then
                    pcall(function()
                        if fireproximityprompt then fireproximityprompt(obj) end
                    end)
                    return false
                end
            end
        end
        return false
    end

    -- Instant Claim khusus tombol Claim di dalam jendela Cauldron (tidak menyentuh Daily/Quest Claim)
    local function claimFinishedPillInCauldron()
        local cauldronHeader = findVisibleTextElement("alchemy cauldron", false)
            or findVisibleTextElement("brew", true)
            or findVisibleTextElement("stoke", true)

        local rootContainer = cauldronHeader and cauldronHeader:FindFirstAncestorOfClass("ScreenGui") or LocalPlayer:FindFirstChild("PlayerGui")
        if not rootContainer then return false end

        local claimed = false
        for _, obj in pairs(rootContainer:GetDescendants()) do
            if not obj:IsDescendantOf(UI.ScreenGui) and (obj:IsA("TextLabel") or obj:IsA("TextButton")) then
                local t = trimText(obj.Text)
                if t == "claim" or t == "collect" or t == "claim pill" then
                    -- Pastikan bukan tombol Daily Reward ("already claimed today")
                    local pName = (obj.Parent and obj.Parent.Name or ""):lower()
                    if not pName:find("daily") and not pName:find("quest") and not pName:find("reward") then
                        triggerGuiClick(obj, true, false)
                        claimed = true
                    end
                end
            end
        end

        -- Tembakkan RemoteEvent selesai masak pil jika tersedia di ReplicatedStorage.CultivationEvents
        pcall(function()
            local cultEvents = ReplicatedStorage:FindFirstChild("CultivationEvents") or ReplicatedStorage
            for _, rem in pairs(cultEvents:GetDescendants()) do
                if rem:IsA("RemoteEvent") then
                    local rn = rem.Name:lower()
                    if rn:find("claimpill") or rn:find("collectpill") or rn:find("finishbrew") or rn == "claimcauldron" then
                        rem:FireServer()
                    end
                end
            end
        end)

        return claimed
    end

    -- Memilih Herb dari jendela "Choose a herb" (Mendukung format "1000-Year", "100-Year", multi-line text, & auto-scroll)
    local function chooseBestHerbFromList(herbName)
        local modalHeader = findVisibleTextElement("choose a herb", false)
        if not modalHeader then return false end

        local modalWindow = modalHeader.Parent
        while modalWindow and modalWindow ~= LocalPlayer.PlayerGui and modalWindow.AbsoluteSize.Y < 220 do
            modalWindow = modalWindow.Parent
        end
        if not modalWindow then modalWindow = LocalPlayer.PlayerGui end

        local herbLower = trimText(herbName)
        local candidates = {}

        -- Cari semua tombol "Choose" di dalam jendela "Choose a herb"
        for _, obj in pairs(modalWindow:GetDescendants()) do
            if not obj:IsDescendantOf(UI.ScreenGui) and (obj:IsA("TextLabel") or obj:IsA("TextButton")) and trimText(obj.Text) == "choose" then
                local chooseBtn = obj:IsA("GuiButton") and obj or obj:FindFirstAncestorWhichIsA("GuiButton") or obj.Parent
                local row = chooseBtn and chooseBtn.Parent
                if row and row.AbsoluteSize.X < 150 and row.Parent then
                    row = row.Parent
                end

                if row then
                    local rowTexts = {}
                    for _, ch in pairs(row:GetDescendants()) do
                        if ch:IsA("TextLabel") or ch:IsA("TextButton") then
                            table.insert(rowTexts, ch.Text or "")
                        end
                    end
                    local combinedRowText = table.concat(rowTexts, " "):lower()

                    -- Cek apakah baris ini adalah tanaman yang dicari (misal "ginseng")
                    if combinedRowText:find(herbLower, 1, true) then
                        local yearScore = 1
                        if combinedRowText:find("1000", 1, true) then
                            yearScore = 4
                        elseif combinedRowText:find("100", 1, true) then
                            yearScore = 3
                        elseif combinedRowText:find("10", 1, true) then
                            yearScore = 2
                        end

                        local qty = 1
                        local qtyMatch = combinedRowText:match("x(%d+)")
                        if qtyMatch then
                            qty = tonumber(qtyMatch) or 1
                        end

                        if qty > 0 then
                            table.insert(candidates, {
                                Row = row,
                                ChooseBtn = chooseBtn,
                                Score = yearScore
                            })
                        end
                    end
                end
            end
        end

        if #candidates == 0 then
            return false
        end

        -- Urutkan dari 1000-Year (4) -> 100-Year (3) -> 10-Year (2) -> 1-Year (1)
        table.sort(candidates, function(a, b)
            return a.Score > b.Score
        end)

        local best = candidates[1]
        local scrollFrame = best.Row:FindFirstAncestorWhichIsA("ScrollingFrame")
        if scrollFrame then
            local sfY = scrollFrame.AbsolutePosition.Y
            local sfH = scrollFrame.AbsoluteSize.Y
            local rY = best.Row.AbsolutePosition.Y
            local rH = best.Row.AbsoluteSize.Y

            if rY < sfY or (rY + rH) > (sfY + sfH) then
                scrollFrame.CanvasPosition = Vector2.new(
                    scrollFrame.CanvasPosition.X,
                    math.max(0, scrollFrame.CanvasPosition.Y + (rY - sfY) - (sfH * 0.35))
                )
                task.wait(0.18)
            end
        end

        triggerGuiClick(best.ChooseBtn, false, true)
        return true
    end

    -- Menyelesaikan minigame "Stoke the Fire" secara akurat lalu langsung Instant Claim
    local function handleStokeMinigame(stokeBtnObj)
        local modalContainer = stokeBtnObj.Parent
        while modalContainer and modalContainer ~= LocalPlayer.PlayerGui and modalContainer.AbsoluteSize.Y < 130 do
            modalContainer = modalContainer.Parent
        end
        if not modalContainer then return end

        local stokeY = stokeBtnObj.AbsolutePosition.Y
        local initialX = {}
        for _, obj in pairs(modalContainer:GetDescendants()) do
            if obj:IsA("GuiObject") and isActuallyVisible(obj) and obj.AbsolutePosition.Y < stokeY then
                if obj.AbsoluteSize.X < 180 and obj.AbsoluteSize.Y <= 60 then
                    initialX[obj] = obj.AbsolutePosition.X
                end
            end
        end

        RunService.RenderStepped:Wait()
        RunService.RenderStepped:Wait()
        RunService.RenderStepped:Wait()

        local cursorObj = nil
        local maxDelta = 0
        for obj, oldX in pairs(initialX) do
            if obj and obj.Parent then
                local dX = math.abs(obj.AbsolutePosition.X - oldX)
                if dX > 0.4 and dX > maxDelta then
                    maxDelta = dX
                    cursorObj = obj
                end
            end
        end

        local targetZoneObj = nil
        local barTrackObj = nil
        local refY = cursorObj and (cursorObj.AbsolutePosition.Y + cursorObj.AbsoluteSize.Y / 2) or (stokeY - 45)

        for _, obj in pairs(modalContainer:GetDescendants()) do
            if obj:IsA("GuiObject") and isActuallyVisible(obj) and obj ~= cursorObj and (not cursorObj or not obj:IsDescendantOf(cursorObj)) then
                local centerY = obj.AbsolutePosition.Y + (obj.AbsoluteSize.Y / 2)
                if math.abs(centerY - refY) < 35 then
                    if obj.AbsoluteSize.X >= 180 and obj.AbsoluteSize.Y <= 50 then
                        if not barTrackObj or obj.AbsoluteSize.X > barTrackObj.AbsoluteSize.X then barTrackObj = obj end
                    elseif obj.AbsoluteSize.X >= 6 and obj.AbsoluteSize.X <= 90 and obj.AbsoluteSize.Y <= 45 then
                        local dX = initialX[obj] and math.abs(obj.AbsolutePosition.X - initialX[obj]) or 0
                        if dX < 0.2 and (not targetZoneObj or obj.AbsoluteSize.X < targetZoneObj.AbsoluteSize.X) then
                            targetZoneObj = obj
                        end
                    end
                end
            end
        end

        local startTime = tick()
        local prevX = cursorObj and (cursorObj.AbsolutePosition.X + cursorObj.AbsoluteSize.X / 2) or nil

        while State.autoPillActive and isActuallyVisible(stokeBtnObj) and (tick() - startTime < 4.0) do
            if cursorObj then
                local curCenter = cursorObj.AbsolutePosition.X + (cursorObj.AbsoluteSize.X / 2)
                local velX = prevX and (curCenter - prevX) or 0
                prevX = curCenter
                local predictedX = curCenter + (velX * 1.15)

                local zMin, zMax
                if targetZoneObj then
                    local zPos = targetZoneObj.AbsolutePosition.X
                    local zSize = targetZoneObj.AbsoluteSize.X
                    local pad = math.min(zSize * 0.2, 6)
                    zMin = zPos + pad
                    zMax = (zPos + zSize) - pad
                elseif barTrackObj then
                    local bPos = barTrackObj.AbsolutePosition.X
                    local bSize = barTrackObj.AbsoluteSize.X
                    zMin = bPos + (bSize * 0.46)
                    zMax = bPos + (bSize * 0.54)
                end

                if zMin and zMax and ((predictedX >= zMin and predictedX <= zMax) or (curCenter >= zMin and curCenter <= zMax)) then
                    triggerGuiClick(stokeBtnObj, true, true)
                    break
                end
            end
            RunService.RenderStepped:Wait()
        end

        -- Begitu minigame Stoke selesai, langsung eksekusi Instant Claim tanpa spam saat idle
        task.wait(0.2)
        for _ = 1, 8 do
            if not State.autoPillActive then break end
            if claimFinishedPillInCauldron() then
                task.wait(0.25)
            end
            if findVisibleTextElement("add herb", true) or findVisibleTextElement("brew", true) then
                break
            end
            task.wait(0.2)
        end
    end

    local nextSlotToFill = 1

    while true do
        if State.autoPillActive and not isUserTypingOrInMenu() then
            openCauldronIfClosed()

            -- STATE 1: Jika tombol Claim pil yang sudah matang terlihat di layar, klik langsung
            local visibleClaim = findVisibleTextElement("claim", true)
            if visibleClaim then
                triggerGuiClick(visibleClaim, false, true)
                task.wait(0.45)

            -- STATE 2: Jika minigame Stoke sedang muncul di layar
            else
                local stokeObj = findVisibleTextElement("stoke", true)
                if stokeObj then
                    handleStokeMinigame(stokeObj)
                    nextSlotToFill = 1
                    task.wait(0.35)

                -- STATE 3: Jika jendela pemilihan "Choose a herb" sedang terbuka
                elseif findVisibleTextElement("choose a herb", false) then
                    local recipe = Constants.PILL_RECIPES[State.selectedPill]
                    local targetHerb = recipe and recipe[nextSlotToFill] or "Ginseng"

                    local chosen = chooseBestHerbFromList(targetHerb)
                    if chosen then
                        nextSlotToFill = (nextSlotToFill % 3) + 1
                        task.wait(0.45)
                    else
                        local backBtn = findVisibleTextElement("back", true)
                        if backBtn then
                            triggerGuiClick(backBtn, false, true)
                        end
                        task.wait(0.5)
                    end

                -- STATE 4: Berada di menu utama ALCHEMY CAULDRON
                else
                    local brewBtn = findVisibleTextElement("brew", true)
                    if brewBtn then
                        local emptySlotBtn = findVisibleTextElement("add herb", true)
                        if emptySlotBtn then
                            -- Klik 1 slot "Add herb" dan tunggu dengan smooth sampai menu "Choose a herb" terbuka
                            triggerGuiClick(emptySlotBtn, false, true)
                            task.wait(0.45)
                        else
                            -- Ketiga slot sudah terisi penuh (tidak ada lagi tombol "Add herb"), klik Brew!
                            nextSlotToFill = 1
                            triggerGuiClick(brewBtn, false, true)
                            task.wait(0.65)
                        end
                    end
                end
            end
        end
        task.wait(0.22)
    end
end)


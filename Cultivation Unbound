        end

        -- Menarik Workspace.CauldronForBrewing secara lokal ke karakter agar bisa buka Cauldron dari mana saja di Map!
        local function bringCauldronAndOpenIfClosed()
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local cauldronMesh = Workspace:FindFirstChild("CauldronForBrewing")

            -- Selalu jaga jarak CauldronForBrewing dekat dengan karakter selama Auto Pill aktif agar server/client tidak menutup UI karena jarak
            if cauldronMesh and cauldronMesh:IsA("BasePart") and root then
                pcall(function()

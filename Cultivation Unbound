do
    -- Mengambil posisi 3D dari objek apa pun bahkan jika BasePart di dalamnya belum ter-stream
    local function extractWorldPosition(obj)
        if not obj then return nil end
        if obj:IsA("BasePart") then
            return obj.Position
        elseif obj:IsA("Model") then
            local ok, cf = pcall(function() return obj:GetPivot() end)
            if ok and cf and cf.Position.Magnitude > 1 then
                return cf.Position
            end
            local ok2, bboxCf = pcall(function()
                local c, _ = obj:GetBoundingBox()
                return c
            end)
            if ok2 and bboxCf and bboxCf.Position.Magnitude > 1 then
                return bboxCf.Position
            end
        elseif obj:IsA("Attachment") then
            return obj.WorldPosition
        elseif obj:IsA("CFrameValue") then
            return obj.Value.Position
        elseif obj:IsA("Vector3Value") then
            return obj.Value
        end

        for _, child in pairs(obj:GetDescendants()) do
            if child:IsA("BasePart") then
                return child.Position
            elseif child:IsA("Model") then
                local ok, cf = pcall(function() return child:GetPivot() end)
                if ok and cf and cf.Position.Magnitude > 1 then
                    return cf.Position
                end
            elseif child:IsA("CFrameValue") and child.Value.Position.Magnitude > 1 then
                return child.Value.Position
            elseif child:IsA("Vector3Value") and child.Value.Magnitude > 1 then
                return child.Value
            end
        end
        return nil
    end

    -- Mencari titik lantai/pusat buff zona yang sudah ter-stream di dekat koordinat
    local function refineZoneBuffFloorPosition(rawPos, zoneName)
        local normTarget = normalizeName(zoneName)
        local bestPart = nil
        local bestPriority = -1
        local largestArea = 0

        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") and (obj.Position - rawPos).Magnitude < 180 then
                local pName = obj.Name:lower()
                local parentName = obj.Parent and normalizeName(obj.Parent.Name) or ""
                local isZonePart = parentName:find(normTarget, 1, true) or normalizeName(obj.Name):find(normTarget, 1, true)

                local priority = 0
                if pName:find("zone") or pName:find("buff") or pName:find("area") or pName:find("hitbox") or pName:find("center") or pName:find("floor") or pName:find("pad") or pName:find("circle") or pName:find("mat") then
                    priority = isZonePart and 4 or 3
                elseif isZonePart and not pName:find("sign") and not pName:find("banner") and not pName:find("wall") and not pName:find("roof") and not pName:find("pillar") then
                    priority = 2
                end

                if priority > 0 then
                    local footprint = obj.Size.X * obj.Size.Z
                    if priority > bestPriority or (priority == bestPriority and footprint > largestArea) then
                        bestPriority = priority
                        largestArea = footprint
                        bestPart = obj
                    end
                end
            end
        end

        local centerPos = bestPart and bestPart.Position or rawPos

        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = {LocalPlayer.Character}

        local rayResult = Workspace:Raycast(Vector3.new(centerPos.X, centerPos.Y + 60, centerPos.Z), Vector3.new(0, -200, 0), rayParams)
        if rayResult then
            return rayResult.Position + Vector3.new(0, 3.2, 0)
        end
        return centerPos + Vector3.new(0, 3.2, 0)
    end

    -- Mencari koordinat zona di Workspace, ReplicatedStorage, dan Cache
    local function findZoneCoordinatesAnywhere(zoneName)
        local normTarget = normalizeName(zoneName)

        -- 1. Pindai Workspace & ReplicatedStorage (termasuk Model yang belum ter-stream BasePart-nya)
        for _, container in ipairs({Workspace, ReplicatedStorage}) do
            for _, obj in pairs(container:GetDescendants()) do
                local matched = false
                local objNorm = normalizeName(obj.Name)

                if objNorm ~= "" and (objNorm:find(normTarget, 1, true) or normTarget:find(objNorm, 1, true)) and #objNorm >= 6 then
                    matched = true
                elseif (obj:IsA("TextLabel") or obj:IsA("TextBox")) and normalizeName(obj.Text):find(normTarget, 1, true) then
                    local anc = obj:FindFirstAncestorOfClass("Model") or obj:FindFirstAncestorWhichIsA("BasePart") or obj.Parent
                    local pos = extractWorldPosition(anc)
                    if pos then
                        State.zoneCache[zoneName] = pos
                        return pos
                    end
                elseif obj:IsA("StringValue") and normalizeName(obj.Value):find(normTarget, 1, true) then
                    local pos = extractWorldPosition(obj.Parent)
                    if pos then
                        State.zoneCache[zoneName] = pos
                        return pos
                    end
                end

                if not matched and (obj:IsA("Model") or obj:IsA("BasePart") or obj:IsA("Folder") or obj:IsA("Configuration")) then
                    pcall(function()
                        for _, attrVal in pairs(obj:GetAttributes()) do
                            if normalizeName(tostring(attrVal)):find(normTarget, 1, true) then
                                matched = true
                                break
                            end
                        end
                    end)
                end

                if matched then
                    local pos = extractWorldPosition(obj)
                    if pos then
                        State.zoneCache[zoneName] = pos
                        return pos
                    end
                end
            end
        end

        if State.zoneCache[zoneName] then
            return State.zoneCache[zoneName]
        end

        return nil
    end

    -- Jika zona sangat jauh dan belum dimuat oleh StreamingEnabled, pindai titik-titik map secara kilat
    local function streamScanMapForZone(zoneName)
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local originCFrame = root and root.CFrame

        -- Kumpulkan kandidat Model besar / pulau / penanda area di Workspace yang memiliki WorldPivot jauh
        local probePoints = {}
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("Model") then
                local ok, cf = pcall(function() return obj:GetPivot() end)
                if ok and cf and cf.Position.Magnitude > 10 then
                    local tooClose = false
                    for _, pt in ipairs(probePoints) do
                        if (pt - cf.Position).Magnitude < 450 then
                            tooClose = true
                            break
                        end
                    end
                    if not tooClose then
                        table.insert(probePoints, cf.Position)
                    end
                end
            end
        end

        -- Tambahkan grid pencarian luas jika model belum tampak
        local gridOffsets = {
            Vector3.new(1500, 200, 0), Vector3.new(-1500, 200, 0),
            Vector3.new(0, 200, 1500), Vector3.new(0, 200, -1500),
            Vector3.new(1500, 300, 1500), Vector3.new(-1500, 300, 1500),
            Vector3.new(1500, 300, -1500), Vector3.new(-1500, 300, -1500),
            Vector3.new(3000, 400, 0), Vector3.new(-3000, 400, 0),
            Vector3.new(0, 400, 3000), Vector3.new(0, 400, -3000)
        }
        for _, off in ipairs(gridOffsets) do
            table.insert(probePoints, off)
        end

        for _, pt in ipairs(probePoints) do
            pcall(function()
                LocalPlayer:RequestStreamAroundAsync(pt, 1.5)
            end)
            if root then
                root.CFrame = CFrame.new(pt)
            end
            task.wait(0.08)
            local found = findZoneCoordinatesAnywhere(zoneName)
            if found then
                return found
            end
        end

        if root and originCFrame then
            root.CFrame = originCFrame
        end
        return nil
    end

    instantTeleportToZone = function(zoneName)
        if State.isTeleportingZone then return end
        State.isTeleportingZone = true

        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local root = char:FindFirstChild("HumanoidRootPart")

        if not root then
            UI.ZoneStatusLabel.Text = "Status: Karakter belum siap!"
            State.isTeleportingZone = false
            return
        end

        UI.ZoneStatusLabel.Text = "Mencari koordinat " .. zoneName .. "..."
        local targetPos = findZoneCoordinatesAnywhere(zoneName)

        -- Jika belum ter-stream karena jarak terlalu jauh, muat stream area map
        if not targetPos then
            UI.ZoneStatusLabel.Text = "Memuat area jauh (Streaming Map) untuk " .. zoneName .. "..."
            targetPos = streamScanMapForZone(zoneName)
        end

        if not targetPos then
            UI.ZoneStatusLabel.Text = "Gagal menemukan '" .. zoneName .. "' di Map."
            State.isTeleportingZone = false
            return
        end

        UI.ZoneStatusLabel.Text = "Instant Teleport ke " .. zoneName .. "..."

        -- 1. Minta server men-stream area tujuan
        pcall(function()
            LocalPlayer:RequestStreamAroundAsync(targetPos, 3)
        end)

        -- 2. INSTANT TELEPORT (Tanpa Terbang / Tanpa TweenService)
        root.Velocity = Vector3.new(0, 0, 0)
        char:PivotTo(CFrame.new(targetPos + Vector3.new(0, 5, 0)))
        root.CFrame = CFrame.new(targetPos + Vector3.new(0, 5, 0))

        -- 3. Tunggu sebentar agar lantai zona ter-render, lalu kunci tepat di tengah lantai Buff Zone
        task.wait(0.25)
        local preciseBuffPos = refineZoneBuffFloorPosition(targetPos, zoneName)
        State.zoneCache[zoneName] = preciseBuffPos

        root.Velocity = Vector3.new(0, 0, 0)
        char:PivotTo(CFrame.new(preciseBuffPos))
        root.CFrame = CFrame.new(preciseBuffPos)

        -- Reset timer kultivasi agar Auto Realm / Auto Body langsung lanjut di tempat baru
        State.lastQiGainTick = 0
        State.lastBodyGainTick = 0

        UI.ZoneStatusLabel.Text = "Berhasil Instant Teleport ke buff zone: " .. zoneName .. "!"
        State.isTeleportingZone = false
    end
end

